# Copy to .env and fill in real values. .env is gitignored — never commit it.

# OpenRouter: one key covers both the research agent (text) and image generation.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily: web search for the research agent. Free tier at https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Models (defaults are fine; override to experiment)
AGENT_MODEL=google/gemini-3.1-flash-lite
IMAGE_MODEL=google/gemini-3.1-flash-lite-image

# Bounds — the assignment requires configurable limits on the research agent.
MAX_SEARCH_CALLS=5
MAX_FETCH_CALLS=5
MAX_AGENT_STEPS=6
STAGE_TIMEOUT_SECONDS=180

# FIXTURE_MODE=1 runs the whole pipeline from canned data with zero API calls
# and zero cost. Used by the tests and by reviewers without keys.
FIXTURE_MODE=0
